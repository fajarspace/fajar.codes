# Supabase → Project settings → API Keys
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Use the publishable key (sb_publishable_…). The legacy anon JWT also works,
# under either of these names:
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_SUPABASE_ANON_KEY=eyJ...

# Public URL of the deployed site (used for canonical URLs, Open Graph and sitemap)
VITE_SITE_URL=https://fajar.codes
